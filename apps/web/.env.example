# Public browser values may be committed only as placeholders. Never place a
# service-role key in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SITE_URL=https://staging.example.invalid
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-staging-anon-key

# Server-side only. Set this in the staging host's secret store, never in Git.
SUPABASE_SERVICE_ROLE_KEY=replace-with-staging-service-role-key
